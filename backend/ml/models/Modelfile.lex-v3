MESSAGE assistant {"agent_id": "knowledge_agent", "reasoning": "Document search = knowledge_agent, classic corpus Q&A", "tools_needed": [], "urgency": "medium", "confidence": 0.85, "ordo_lane": "positioning", "ordo_inferred": false, "ordo_assessment": "Clear knowledge_agent task"}

