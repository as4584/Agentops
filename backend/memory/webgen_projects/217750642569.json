          "html": "<header class=\"relative h-[70vh] flex items-center justify-center text-white\" style=\"background: linear-gradient(135deg, #2563EB 0%, #3B82F6 60%, #0f172a 100%)\">\n    <div class=\"container mx-auto text-center\">\n        <h1 style=\"animation: fadeInUp 0.8s ease-out both\" class=\"text-4xl font-bold mb-4\">Welcome to Bubble Up Laundromat</h1>\n        <p class=\"text-lg mb-6 opacity-75\">Modern laundromat in Brooklyn</p>\n        <button role=\"button\" aria-label=\"Book Now\" class=\"px-8 py-3 bg-accent text-white rounded-md font-bold shadow-lg transition-all duration-300 hover:scale-105 hover:shadow-xl\">Get Started</button>\n    </div>\n</header>",
