          "html": "<section id=\"faq\" class=\"bg-[#f9fafb] py-24\">\n  <div class=\"container mx-auto px-6\">\n    <header>\n      <h1 class=\"text-3xl font-bold text-center mb-8 gradient-text\">FAQ</h1>\n    </header>\n    <main>\n      <div class=\"accordion\">\n        <details open>\n          <summary class=\"flex items-center justify-between p-4 bg-white rounded-lg shadow-md hover:shadow-xl transition-all duration-300\" role=\"button\" aria-label=\"What types of machines do you have?\">\n            <span class=\"font-semibold\">What types of machines do you have?</span>\n          </summary>\n          <div class=\"p-4 bg-gray-50 rounded-lg shadow-md hover:shadow-xl transition-all duration-300\">\n            We offer coinless washing machines, drying racks, and a variety of other laundry equipment.\n          </div>\n        </details>\n        <details>\n          <summary class=\"flex items-center justify-between p-4 bg-white rounded-lg shadow-md hover:shadow-xl transition-all duration-300\" role=\"button\" aria-label=\"Do you have snack and drink options?\">\n            <span class=\"font-semibold\">Do you have snack and drink options?</span>\n          </summary>\n          <div class=\"p-4 bg-gray-50 rounded-lg shadow-md hover:shadow-xl transition-all duration-300\">\n            Yes, we provide snacks and drinks for your convenience.\n          </div>\n        </details>\n      </div>\n    </main>\n  </div>\n</section>\n\n<style>\n  .gradient-text {\n    background: linear-gradient(90deg, #2563eb, #ea580c);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .accordion summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .accordion summary::before {\n    content: '+';\n    margin-right: 1rem;\n    transition: transform 0.3s ease;\n  }\n\n  .accordion details[open] summary::before {\n    transform: rotate(-45deg);\n  }\n</style>",
