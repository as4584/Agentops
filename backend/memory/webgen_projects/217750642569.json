          "html": "<section id=\"contact\" class=\"bg-gradient-to-br from-primary to-secondary py-24\">\n  <div class=\"container mx-auto px-4\">\n    <header>\n      <h1 class=\"text-white text-3xl font-bold mb-8\" style=\"animation: fadeInUp 0.8s ease-out both\">Get in Touch</h1>\n    </header>\n    <main class=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n      <form action=\"#\" method=\"POST\" class=\"glass-card p-6 shadow-lg rounded-lg\">\n        <div class=\"mb-4\">\n          <label for=\"name\" class=\"block text-gray-700 font-bold mb-2\">Name</label>\n          <input type=\"text\" id=\"name\" name=\"name\" class=\"w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-primary\">\n        </div>\n        <div class=\"mb-4\">\n          <label for=\"email\" class=\"block text-gray-700 font-bold mb-2\">Email</label>\n          <input type=\"email\" id=\"email\" name=\"email\" class=\"w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-primary\">\n        </div>\n        <div class=\"mb-4\">\n          <label for=\"phone\" class=\"block text-gray-700 font-bold mb-2\">Phone Number</label>\n          <input type=\"tel\" id=\"phone\" name=\"phone\" class=\"w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-primary\">\n        </div>\n        <div class=\"mb-4\">\n          <label for=\"message\" class=\"block text-gray-700 font-bold mb-2\">Message</label>\n          <textarea id=\"message\" name=\"message\" rows=\"5\" class=\"w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-primary\"></textarea>\n        </div>\n        <button type=\"submit\" role=\"button\" aria-label=\"Send Message\" class=\"bg-accent text-white font-bold py-2 px-4 rounded hover:scale-105 hover:shadow-xl\">Send Message</button>\n      </form>\n    </main>\n  </div>\n</section>",
