      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Services - {business_name}</title>\n  <meta name=\"description\" content=\"\">\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Open+Sans:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n  <style>\n/* WebGen Global Styles */\n:root {\n  --color-primary: #2563EB;\n  --color-secondary: #3B82F6;\n  --color-accent: #EA580C;\n  --color-bg: #F8FAFC;\n  --color-fg: #1E293B;\n  --font-heading: 'Poppins', system-ui, -apple-system, sans-serif;\n  --font-body: 'Open Sans', system-ui, -apple-system, sans-serif;\n}\n\nbody {\n  font-family: var(--font-body);\n  color: #1f2937;\n  line-height: 1.6;\n}\n\nh1, h2, h3, h4, h5, h6 {\n  font-family: var(--font-heading);\n  line-height: 1.2;\n}\n\na {\n  color: var(--color-primary);\n  text-decoration: none;\n}\n\na:hover {\n  text-decoration: underline;\n}\n\n.btn-primary {\n  background-color: var(--color-primary);\n  color: white;\n  padding: 0.75rem 1.5rem;\n  border-radius: 0.5rem;\n  font-weight: 600;\n  transition: background-color 0.2s;\n}\n\n.btn-primary:hover {\n  background-color: var(--color-secondary);\n  transform: scale(1.05);\n  box-shadow: 0 20px 40px rgba(0,0,0,0.2);\n}\n\n/* \u2500\u2500 Premium animation keyframes \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n@keyframes fadeInUp {\n  from { opacity: 0; transform: translateY(32px); }\n  to   { opacity: 1; transform: translateY(0); }\n}\n\n@keyframes slideInLeft {\n  from { opacity: 0; transform: translateX(-40px); }\n  to   { opacity: 1; transform: translateX(0); }\n}\n\n@keyframes glowPulse {\n  0%, 100% { box-shadow: 0 0 20px #EA580C4d; }\n  50%       { box-shadow: 0 0 40px #EA580Cb3; }\n}\n\n@keyframes gradientShift {\n  0%   { background-position: 0% 50%; }\n  50%  { background-position: 100% 50%; }\n  100% { background-position: 0% 50%; }\n}\n\n/* \u2500\u2500 Glassmorphism card \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.glass-card {\n  background: rgba(255, 255, 255, 0.08);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(255, 255, 255, 0.15);\n  border-radius: 1rem;\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\n}\n\n.glass-card:hover {\n  transform: translateY(-8px);\n  box-shadow: 0 24px 48px rgba(0, 0, 0, 0.3);\n}\n\n/* \u2500\u2500 Gradient text utility \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.gradient-text {\n  background: linear-gradient(90deg, #2563EB, #EA580C);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n\n/* \u2500\u2500 Animated hero gradient background \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.hero-gradient {\n  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 50%, #0f172a 100%);\n  background-size: 200% 200%;\n  animation: gradientShift 8s ease infinite;\n}\n\n/* \u2500\u2500 Scroll-reveal (JS-free fade) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.reveal {\n  opacity: 0;\n  transform: translateY(24px);\n  transition: opacity 0.7s ease, transform 0.7s ease;\n}\n\n.reveal.visible {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n  </style>\n</head>\n<body class=\"min-h-screen bg-white\">\n\n<section class=\"bg-gradient-to-br from-primary to-secondary transition duration-1000 ease\">\n  <div class=\"container mx-auto px-4 py-8 lg:px-6 lg:py-12 flex flex-col items-center justify-between gap-8 sm:gap-16 lg:gap-24 xl:gap-32\">\n    <h1 class=\"text-5xl font-bold text-primary mb-10 lg:mb-16\" style=\"animation: fadeInUp 0.8s ease-out both;\">Overview of Services</h1>\n    <div class=\"flex flex-col items-center gap-4 sm:gap-8 lg:gap-12 xl:gap-16\">\n      <p class=\"text-lg text-gray-700 mb-4 lg:mb-8\" style=\"animation: fadeInUp 0.4s ease-in-out both;\">A brief description of the services we offer.</p>\n      <div class=\"flex flex-wrap gap-4 sm:gap-8 lg:gap-12 xl:gap-16\">\n        <button role=\"button\" aria-label=\"Service 1\" class=\"btn btn-primary hover:bg-secondary text-white border-none font-bold py-3 px-4 rounded sm:px-6 sm:py-4 lg:px-8 lg:py-6 xl:px-10 xl:py-8\">Service 1</button>\n        <button role=\"button\" aria-label=\"Service 2\" class=\"btn btn-primary hover:bg-secondary text-white border-none font-bold py-3 px-4 rounded sm:px-6 sm:py-4 lg:px-8 lg:py-6 xl:px-10 xl:py-8\">Service 2</button>\n        <button role=\"button\" aria-label=\"Service 3\" class=\"btn btn-primary hover:bg-secondary text-white border-none font-bold py-3 px-4 rounded sm:px-6 sm:py-4 lg:px-8 lg:py-6 xl:px-10 xl:py-8\">Service 3</button>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"bg-gradient-to-r from-primary-500 to-secondary-500 py-12 text-center md:text-left\">\n  <h1 class=\"w-full mb-8 font-poppins text-3xl lg:text-4xl leading-normal md:text-start\">Wash & Fold</h1>\n  <div class=\"md:hidden w-full h-[calc(100vh-6rem)] md:block md:w-2/3 mb-8 md:mb-0\">\n    <img src=\"/path/to/image\" alt=\"\" class=\"max-w-full h-auto rounded-lg shadow\">\n  </div>\n  <p class=\"text-body leading-relaxed text-left mb-4\">Our wash and fold service is perfect for busy individuals. Trust us to take care of your laundry needs so you can focus on more important things.</p>\n  <div class=\"md:hidden w-full h-[calc(100vh-6rem)] md:block md:w-2/3 mb-8 md:mb-0\">\n    <img src=\"/path/to/image\" alt=\"\" class=\"max-w-full h-auto rounded-lg shadow\">\n  </div>\n  <h2 class=\"font-poppins text-xl mb-4 md:text-start\">Features</h2>\n  <div class=\"flex flex-wrap md:flex-nowrap gap-4 md:gap-0 lg:flex-col\">\n    <div class=\"w-full md:w-1/3 bg-white rounded-lg glass-card transition hover:-translate-y-2 duration-300 shadow-md\">\n      <img src=\"/path/to/image\" alt=\"\" class=\"max-w-full h-auto rounded-lg\">\n      <h3 class=\"font-poppins text-accent mb-2\">Fast Turnaround Time</h3>\n      <p class=\"text-body leading-relaxed\">We understand that time is of the essence, which is why we offer a fast turnaround time for all our services.</p>\n    </div>\n    <div class=\"w-full md:w-1/3 bg-white rounded-lg glass-card transition hover:-translate-y-2 duration-300 shadow-md\">\n      <img src=\"/path/to/image\" alt=\"\" class=\"max-w-full h-auto rounded-lg\">\n      <h3 class=\"font-poppins text-accent mb-2\">High-Quality Service</h3>\n      <p class=\"text-body leading-relaxed\">We pride ourselves on offering high-quality service to each and every one of our customers. Our team of experienced professionals will take care of your laundry needs with the utmost care and attention to detail.</p>\n    </div>\n    <div class=\"w-full md:w-1/3 bg-white rounded-lg glass-card transition hover:-translate-y-2 duration-300 shadow-md\">\n      <img src=\"/path/to/image\" alt=\"\" class=\"max-w-full h-auto rounded-lg\">\n      <h3 class=\"font-poppins text-accent mb-2\">Affordable Prices</h3>\n      <p class=\"text-body leading-relaxed\">We believe that everyone deserves access to high-quality laundry services at affordable prices. That's why we offer competitive pricing on all our services, without compromising on quality.</p>\n    </div>\n  </div>\n  <button type=\"button\" role=\"button\" aria-label=\"Contact Us\">Contact Us</button>\n  <nav class=\"md:hidden w-full h-[calc(100vh-6rem)] md:block md:w-2/3 mb-8 md:mb-0\">\n    <img src=\"/path/to/image\" alt=\"\" class=\"max-w-full h-auto rounded-lg shadow\">\n  </nav>\n</section>\n\n\n\n\n\n</body>\n</html>",
