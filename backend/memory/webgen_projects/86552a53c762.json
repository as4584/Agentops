ge</label>\n    <textarea id=\"message\" name=\"message\" placeholder=\"Enter your message\" required rows=\"5\" class=\"w-full p-3 border border-gray-300 rounded shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 dark:focus:border-gray-700 dark:focus:ring-gray-600\"></textarea>\n    <div class=\"flex justify-end\">\n      <button type=\"submit\" aria-label=\"Submit\">Submit</button>\n    </div>\n  </form>\n  <section class=\"bg-white rounded shadow p-8 mb-4 grid grid-cols-1 lg:grid-cols-2 gap-4\">\n    <div>\n      <h3 class=\"font-semibold text-gray-700 dark:text-gray-400\">Phone</h3>\n      <p>+1 (555) 123-4567</p>\n    </div>\n    <div>\n      <h3 class=\"font-semibold text-gray-700 dark:text-gray-400\">Email</h3>\n      <a href=\"#\" aria-label=\"Email\"><span class=\"block w-24 h-24 rounded-full bg-gray-50 border border-gray-300 shadow\"></span><span class=\"absolute inset-y-1/2 left-1/2 transform translate-x-1/2 text-lg font-bold leading-tight text-gray-700 dark:text-gray-400\">Email</span></a>\n      <p>info@laundrybusiness.com</p>\n    </div>\n  </section>\n</main>\n<footer class=\"bg-gray-100 p-8 text-center\">\n  <p>&copy; 2023 Laundry Business | All Rights Reserved</p>\n</footer>\n\n</body>\n</html>",
