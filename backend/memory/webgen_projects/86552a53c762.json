        {
          "id": "138676c4",
          "name": "wash-and-fold",
          "component_type": "section-with-description",
          "content": {
            "headline": "Wash & Fold",
            "subtitle": "Our wash and fold service is perfect for busy individuals"
          },
          "html": "<section class=\"bg-gradient-to-r from-primary-500 to-secondary-500 py-12 text-center md:text-left\">\n  <h1 class=\"w-full mb-8 font-poppins text-3xl lg:text-4xl leading-normal md:text-start\">Wash & Fold</h1>\n  <div class=\"md:hidden w-full h-[calc(100vh-6rem)] md:block md:w-2/3 mb-8 md:mb-0\">\n    <img src=\"/path/to/image\" alt=\"\" class=\"max-w-full h-auto rounded-lg shadow\">\n  </div>\n  <p class=\"text-body leading-relaxed text-left mb-4\">Our wash and fold service is perfect for busy individuals. Trust us to take care of your laundry needs so you can focus on more important things.</p>\n  <div class=\"md:hidden w-full h-[calc(100vh-6rem)] md:block md:w-2/3 mb-8 md:mb-0\">\n    <img src=\"/path/to/image\" alt=\"\" class=\"max-w-full h-auto rounded-lg shadow\">\n  </div>\n  <h2 class=\"font-poppins text-xl mb-4 md:text-start\">Features</h2>\n  <div class=\"flex flex-wrap md:flex-nowrap gap-4 md:gap-0 lg:flex-col\">\n    <div class=\"w-full md:w-1/3 bg-white rounded-lg glass-card transition hover:-translate-y-2 duration-300 shadow-md\">\n      <img src=\"/path/to/image\" alt=\"\" class=\"max-w-full h-auto rounded-lg\">\n      <h3 class=\"font-poppins text-accent mb-2\">Fast Turnaround Time</h3>\n      <p class=\"text-body leading-relaxed\">We understand that time is of the essence, which is why we offer a fast turnaround time for all our services.</p>\n    </div>\n    <div class=\"w-full md:w-1/3 bg-white rounded-lg glass-card transition hover:-translate-y-2 duration-300 shadow-md\">\n      <img src=\"/path/to/image\" alt=\"\" class=\"max-w-full h-auto rounded-lg\">\n      <h3 class=\"font-poppins text-accent mb-2\">High-Quality Service</h3>\n      <p class=\"text-body leading-relaxed\">We pride ourselves on offering high-quality service to each and every one of our customers. Our team of experienced professionals will take care of your laundry needs with the utmost care and attention to detail.</p>\n    </div>\n    <div class=\"w-full md:w-1/3 bg-white rounded-lg glass-card transition hover:-translate-y-2 duration-300 shadow-md\">\n      <img src=\"/path/to/image\" alt=\"\" class=\"max-w-full h-auto rounded-lg\">\n      <h3 class=\"font-poppins text-accent mb-2\">Affordable Prices</h3>\n      <p class=\"text-body leading-relaxed\">We believe that everyone deserves access to high-quality laundry services at affordable prices. That's why we offer competitive pricing on all our services, without compromising on quality.</p>\n    </div>\n  </div>\n  <button type=\"button\" role=\"button\" aria-label=\"Contact Us\">Contact Us</button>\n  <nav class=\"md:hidden w-full h-[calc(100vh-6rem)] md:block md:w-2/3 mb-8 md:mb-0\">\n    <img src=\"/path/to/image\" alt=\"\" class=\"max-w-full h-auto rounded-lg shadow\">\n  </nav>\n</section>",
