          "html": "<header class=\"bg-gradient-to-br from-indigo-600 to-blue-900 h-screen flex items-center justify-center text-white\">\n  <div class=\"text-center\">\n    <h1 style=\"animation: fadeInUp 0.8s ease-out both\" class=\"text-4xl font-bold mb-2\">Welcome to Bubble Up</h1>\n    <p class=\"text-lg mb-6\">Your destination for unique and innovative solutions</p>\n    <button role=\"button\" aria-label=\"Get Started\" class=\"bg-white text-indigo-600 px-8 py-3 rounded hover:scale-105 hover:shadow-xl transition-all duration-300\">Get Started</button>\n  </div>\n</header>",
